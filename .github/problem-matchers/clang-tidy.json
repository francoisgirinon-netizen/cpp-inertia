{
  "problemMatcher": [
    {
      "owner": "clang-tidy",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*?)(?:\\s+\\[([^\\]\\s]+)\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      ]
    }
  ]
}
