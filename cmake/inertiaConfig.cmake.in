@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The core targets are always loaded: the adapter targets link inertia::core.
find_dependency(nlohmann_json CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/inertia-core-targets.cmake")

if(NOT inertia_FIND_COMPONENTS)
    set(inertia_FIND_COMPONENTS core)
endif()

foreach(_inertia_component IN LISTS inertia_FIND_COMPONENTS)
    set(inertia_${_inertia_component}_FOUND FALSE)
    if(_inertia_component STREQUAL "core")
        set(inertia_core_FOUND TRUE)
    elseif(_inertia_component STREQUAL "fake")
        include("${CMAKE_CURRENT_LIST_DIR}/inertia-fake-targets.cmake")
        set(inertia_fake_FOUND TRUE)
    elseif(_inertia_component STREQUAL "drogon")
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/inertia-drogon-targets.cmake")
            find_dependency(Drogon CONFIG)
            # Drogon's FindFilesystem leaves CMAKE_CXX_STANDARD defined but empty when the
            # consumer had none, which makes the consumer's targets invalid.
            if(DEFINED CMAKE_CXX_STANDARD AND CMAKE_CXX_STANDARD STREQUAL "")
                unset(CMAKE_CXX_STANDARD)
            endif()
            include("${CMAKE_CURRENT_LIST_DIR}/inertia-drogon-targets.cmake")
            set(inertia_drogon_FOUND TRUE)
        else()
            set(inertia_NOT_FOUND_MESSAGE
                "inertia was installed without the Drogon adapter (configured with INERTIA_BUILD_DROGON=OFF)")
        endif()
    elseif(_inertia_component STREQUAL "httplib")
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/inertia-httplib-targets.cmake")
            find_dependency(httplib CONFIG)
            include("${CMAKE_CURRENT_LIST_DIR}/inertia-httplib-targets.cmake")
            set(inertia_httplib_FOUND TRUE)
        else()
            set(inertia_NOT_FOUND_MESSAGE
                "inertia was installed without the cpp-httplib adapter (configured with INERTIA_BUILD_HTTPLIB=OFF)")
        endif()
    elseif(_inertia_component STREQUAL "conformance")
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/inertia-conformance-targets.cmake")
            find_dependency(Catch2 CONFIG)
            include("${CMAKE_CURRENT_LIST_DIR}/inertia-conformance-targets.cmake")
            # inertia_add_conformance_test()
            include("${CMAKE_CURRENT_LIST_DIR}/inertiaConformance.cmake")
            set(inertia_conformance_FOUND TRUE)
        else()
            set(inertia_NOT_FOUND_MESSAGE
                "inertia was installed without the conformance kit (Catch2 was not available when it was configured)")
        endif()
    else()
        set(inertia_NOT_FOUND_MESSAGE
            "unknown inertia component '${_inertia_component}' (available: core, fake, drogon, httplib, conformance)")
    endif()
endforeach()

check_required_components(inertia)
