@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The core targets are always loaded: inertia::fake and inertia::drogon link inertia::core.
find_dependency(nlohmann_json CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/inertia-core-targets.cmake")

if(NOT inertia_FIND_COMPONENTS)
    set(inertia_FIND_COMPONENTS core)
endif()

foreach(_inertia_component IN LISTS inertia_FIND_COMPONENTS)
    set(inertia_${_inertia_component}_FOUND FALSE)
    if(_inertia_component STREQUAL "core")
        set(inertia_core_FOUND TRUE)
    elseif(_inertia_component STREQUAL "fake")
        include("${CMAKE_CURRENT_LIST_DIR}/inertia-fake-targets.cmake")
        set(inertia_fake_FOUND TRUE)
    elseif(_inertia_component STREQUAL "drogon")
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/inertia-drogon-targets.cmake")
            find_dependency(Drogon CONFIG)
            include("${CMAKE_CURRENT_LIST_DIR}/inertia-drogon-targets.cmake")
            set(inertia_drogon_FOUND TRUE)
        else()
            set(inertia_drogon_NOT_FOUND_MESSAGE
                "inertia was installed without the Drogon adapter (configured with INERTIA_BUILD_DROGON=OFF)")
        endif()
    else()
        set(inertia_${_inertia_component}_NOT_FOUND_MESSAGE
            "unknown inertia component '${_inertia_component}' (available: core, fake, drogon)")
    endif()
endforeach()

check_required_components(inertia)
