{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CMAKE_C_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache",
        "INERTIA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "shared-linux",
      "hidden": true,
      "description": "Shared inertia libraries. Their dependencies are shared too (the x64-linux-dynamic triplet): a static Drogon would be copied into libinertia_drogon.so and into the program, and the two copies of its app() singleton would not see each other",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
        "VCPKG_HOST_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "dev",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INERTIA_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "gcc",
      "description": "GCC (g++-15 in the dev image): a portability proxy for the other compilers. Same as dev otherwise, without the benchmarks",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc-15",
        "CMAKE_CXX_COMPILER": "g++-15"
      }
    },
    {
      "name": "dev-shared",
      "description": "The dev preset with shared libraries",
      "inherits": [
        "dev",
        "shared-linux"
      ]
    },
    {
      "name": "core-only",
      "description": "Core and fake adapter only: no Drogon, no cpp-httplib (and neither in the vcpkg install)",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INERTIA_BUILD_DROGON": "OFF",
        "INERTIA_BUILD_HTTPLIB": "OFF",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "asan",
      "description": "AddressSanitizer + UBSan (undefined plus the integer, nullability, float-divide-by-zero and local-bounds groups); any report aborts. unsigned-integer-overflow is excluded: libstdc++ std::string::compare (basic_string.h _S_compare, reached from Catch2 sortTests) wraps an unsigned subtraction on purpose, and no code of ours can change that",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined,integer,nullability,float-divide-by-zero,local-bounds -fno-sanitize-recover=all -fno-sanitize=unsigned-integer-overflow -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined,integer,nullability,float-divide-by-zero,local-bounds -fno-sanitize=unsigned-integer-overflow"
      }
    },
    {
      "name": "tsan",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "VCPKG_TARGET_TRIPLET": "x64-linux-tsan",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
      }
    },
    {
      "name": "bench",
      "description": "Release build of the benchmarks only: core and fake adapter, no tests, no frameworks (see benchmarks/)",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INERTIA_BUILD_BENCHMARKS": "ON",
        "INERTIA_BUILD_TESTS": "OFF",
        "INERTIA_BUILD_DROGON": "OFF",
        "INERTIA_BUILD_HTTPLIB": "OFF",
        "INERTIA_INSTALL": "OFF",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
        "VCPKG_MANIFEST_FEATURES": "benchmarks"
      }
    },
    {
      "name": "coverage",
      "description": "Clang source-based line coverage (see tools/coverage-report.sh)",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate",
        "CMAKE_SHARED_LINKER_FLAGS": "-fprofile-instr-generate"
      }
    },
    {
      "name": "release",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INERTIA_COVERAGE_STRICT": "ON"
      }
    },
    {
      "name": "release-shared",
      "description": "The release preset with shared libraries",
      "inherits": [
        "release",
        "shared-linux"
      ]
    },
    {
      "name": "native",
      "hidden": true,
      "description": "Native build on a developer machine or a CI runner: VCPKG_ROOT from the host environment, no compiler launcher",
      "inherits": [
        "vcpkg"
      ],
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "INERTIA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "hidden": true,
      "description": "MSVC through the Visual Studio 2022 generator (cl, /W4 /WX). Debug and Release are build configurations, not presets",
      "inherits": [
        "native"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-static",
      "description": "Static libraries, static C runtime (/MT): the x64-windows-static triplet",
      "inherits": [
        "windows-msvc"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "windows-msvc-shared",
      "description": "DLLs and the dynamic C runtime (/MD): the x64-windows triplet, whose dependencies are DLLs too",
      "inherits": [
        "windows-msvc"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "macos",
      "hidden": true,
      "description": "Apple Clang (the Xcode toolchain) with Ninja, on Apple silicon",
      "inherits": [
        "native"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-static-debug",
      "description": "Static libraries, Debug: the arm64-osx triplet",
      "inherits": [
        "macos"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-static-release",
      "description": "Static libraries, Release: the arm64-osx triplet",
      "inherits": [
        "macos"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-shared-debug",
      "description": "Shared libraries, Debug: the arm64-osx-dynamic triplet",
      "inherits": [
        "macos"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx-dynamic",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "macos-shared-release",
      "description": "Shared libraries, Release: the arm64-osx-dynamic triplet",
      "inherits": [
        "macos"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx-dynamic",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "ON"
      }
    }
  ],
