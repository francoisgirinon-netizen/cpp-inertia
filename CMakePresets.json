{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CMAKE_C_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache",
        "INERTIA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "dev",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INERTIA_BUILD_BENCHMARKS": "ON",
        "VCPKG_MANIFEST_FEATURES": "benchmarks"
      }
    },
    {
      "name": "core-only",
      "description": "Core and fake adapter only: no Drogon, no cpp-httplib (and neither in the vcpkg install)",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INERTIA_BUILD_DROGON": "OFF",
        "INERTIA_BUILD_HTTPLIB": "OFF",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "asan",
      "description": "AddressSanitizer + UBSan (undefined plus the integer, nullability, float-divide-by-zero and local-bounds groups); any report aborts. unsigned-integer-overflow is excluded: libstdc++ std::string::compare (basic_string.h _S_compare, reached from Catch2 sortTests) wraps an unsigned subtraction on purpose, and no code of ours can change that",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined,integer,nullability,float-divide-by-zero,local-bounds -fno-sanitize-recover=all -fno-sanitize=unsigned-integer-overflow -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined,integer,nullability,float-divide-by-zero,local-bounds -fno-sanitize=unsigned-integer-overflow"
      }
    },
    {
      "name": "tsan",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "VCPKG_TARGET_TRIPLET": "x64-linux-tsan",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
      }
    },
    {
      "name": "bench",
      "description": "Release build of the benchmarks only: core and fake adapter, no tests, no frameworks (see benchmarks/)",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INERTIA_BUILD_BENCHMARKS": "ON",
        "INERTIA_BUILD_TESTS": "OFF",
        "INERTIA_BUILD_DROGON": "OFF",
        "INERTIA_BUILD_HTTPLIB": "OFF",
        "INERTIA_INSTALL": "OFF",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
        "VCPKG_MANIFEST_FEATURES": "benchmarks"
      }
    },
    {
      "name": "coverage",
      "description": "Clang source-based line coverage (see tools/coverage-report.sh)",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate",
        "CMAKE_SHARED_LINKER_FLAGS": "-fprofile-instr-generate"
      }
    },
    {
      "name": "release",
      "inherits": [
        "base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INERTIA_COVERAGE_STRICT": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "core-only",
      "configurePreset": "core-only"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "bench",
      "configurePreset": "bench"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "configurePreset": "dev"
    },
    {
      "name": "core-only",
      "inherits": "base",
      "configurePreset": "core-only"
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "strict_string_checks=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1:suppressions=${sourceDir}/tests/tsan.supp"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "configurePreset": "coverage",
      "environment": {
        "LLVM_PROFILE_FILE": "${sourceDir}/build/coverage/profiles/%p-%m.profraw"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    }
  ],
  "packagePresets": [
    {
      "name": "tgz",
      "description": "One TGZ archive with every built component",
      "configurePreset": "release",
      "generators": [
        "TGZ"
      ]
    },
    {
      "name": "deb",
      "description": "One .deb per built component",
      "configurePreset": "release",
      "generators": [
        "DEB"
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        }
      ]
    },
    {
      "name": "core-only",
      "steps": [
        {
          "type": "configure",
          "name": "core-only"
        },
        {
          "type": "build",
          "name": "core-only"
        },
        {
          "type": "test",
          "name": "core-only"
        }
      ]
    },
    {
      "name": "asan",
      "steps": [
        {
          "type": "configure",
          "name": "asan"
        },
        {
          "type": "build",
          "name": "asan"
        },
        {
          "type": "test",
          "name": "asan"
        }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        {
          "type": "configure",
          "name": "tsan"
        },
        {
          "type": "build",
          "name": "tsan"
        },
        {
          "type": "test",
          "name": "tsan"
        }
      ]
    },
    {
      "name": "coverage",
      "steps": [
        {
          "type": "configure",
          "name": "coverage"
        },
        {
          "type": "build",
          "name": "coverage"
        },
        {
          "type": "test",
          "name": "coverage"
        }
      ]
    },
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "package",
      "description": "Configure, build and test the release preset, then produce the TGZ and the .deb packages",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        },
        {
          "type": "package",
          "name": "tgz"
        },
        {
          "type": "package",
          "name": "deb"
        }
      ]
    }
  ]
}
